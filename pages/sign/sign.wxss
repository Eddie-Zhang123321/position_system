/* 页面标题 */
.page-header {
  position: relative;
  text-align: center;
  margin-bottom: 30rpx;
}

.back-btn {
  position: absolute;
  left: 0;
  top: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #333;
  font-size: 26rpx;
}

.back-btn::after {
  border: none;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

/* 座位状态卡片 */
.seat-status-card,
.no-seat-card {
  margin-bottom: 30rpx;
  text-align: center;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.seat-id {
  font-size: 28rpx;
  color: #ff4d4f;
}

.status-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.online-big {
  display: inline-block;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.online-big.online {
  background-color: #f6ffed;
  color: #52C41A;
  border: 2rpx solid #b7eb8f;
}

.online-big.offline {
  background-color: #fafafa;
  color: #999;
  border: 2rpx solid #e5e5e5;
}

/* 签到卡片 */
.sign-card {
  margin-bottom: 30rpx;
  text-align: center;
}

.sign-type-tabs {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.tab-item {
  padding: 12rpx 40rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #4a90e2;
  color: white;
}

.btn-sign {
  background-color: #52c41a;
  color: white;
  border-radius: 10rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
  width: 80%;
  margin: 0 auto;
}

.sign-tips {
  font-size: 24rpx;
  color: #666;
  margin-top: 15rpx;
  display: block;
}

.sign-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 签到记录卡片 */
.records-card {
  margin-bottom: 30rpx;
}

.record-list {
  margin-top: 20rpx;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.record-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
  display: block;
}

.record-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15rpx;
}

.record-type {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: bold;
}

.record-type.type-in {
  background-color: #e6f7ff;
  color: #1890ff;
}

.record-type.type-out {
  background-color: #fff7e6;
  color: #fa8c16;
}

.record-address {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.record-table {
  font-size: 26rpx;
  color: #666;
}

.empty-records {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

.loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #666;
}
