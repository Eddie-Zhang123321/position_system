.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  margin-bottom: 20rpx;
}

.page-header .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

/* 标签页 */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #4a90e2;
  color: #fff;
  font-weight: 600;
}

.tab-content {
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.online-count {
  font-size: 26rpx;
  color: #4a90e2;
  font-weight: 600;
}

.loading-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #666;
  padding: 12rpx 0;
}

.online-status {
  color: #52c41a !important;
  font-weight: 600;
}

.offline-status {
  color: #999 !important;
}

.type-in {
  color: #1890ff !important;
  font-weight: 600;
}

.type-out {
  color: #fa8c16 !important;
  font-weight: 600;
}

.card-actions {
  display: flex;
  align-items: center;
}

/* 二维码弹窗样式 */
.qr-codes-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.qr-codes-scroll {
  flex: 1;
  padding: 20rpx;
}

.qr-codes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  padding-bottom: 20rpx;
}

.qr-code-item {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.qr-code-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
}

.qr-code-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-code-image {
  width: 280rpx;
  height: 280rpx;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
}

.qr-code-actions {
  display: flex;
  gap: 15rpx;
  justify-content: center;
}

.qr-action-btn {
  padding: 8rpx 20rpx;
  background: #4a90e2;
  color: #fff;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.qr-action-btn.save-btn {
  background: #52c41a;
}

.qr-code-error {
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}
