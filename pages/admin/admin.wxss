.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  margin-bottom: 20rpx;
}

.page-header .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

/* 标签页 */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #4a90e2;
  color: #fff;
  font-weight: 600;
}

.tab-content {
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.online-count {
  font-size: 26rpx;
  color: #4a90e2;
  font-weight: 600;
}

.loading-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #666;
  padding: 12rpx 0;
}

.online-status {
  color: #52c41a !important;
  font-weight: 600;
}

.offline-status {
  color: #999 !important;
}

.type-in {
  color: #1890ff !important;
  font-weight: 600;
}

.type-out {
  color: #fa8c16 !important;
  font-weight: 600;
}

.card-actions {
  display: flex;
  align-items: center;
}
.export-panel {
  background: #f7f9fc;
  border-radius: 12rpx;
  padding: 18rpx 16rpx;
  margin-top: 34rpx;
}

.date-range {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.date-range picker {
  flex: 1;
  min-width: 0;
}

.date-picker {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 12rpx;
  border: none;
  border-radius: 8rpx;
  background: #fff;
  color: #333;
  font-size: 24rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: none;
}

.export-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.export-action-item {
  flex: 1;
  min-width: 0;
}

.export-btn {
  width: 100% !important;
}

/* 二维码弹窗样式 */
.qr-codes-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.qr-codes-scroll {
  flex: 1;
  padding: 20rpx;
}

.qr-codes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  padding-bottom: 20rpx;
}

.qr-code-item {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.qr-code-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
}

.qr-code-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-code-image {
  width: 280rpx;
  height: 280rpx;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
}

.qr-code-actions {
  display: flex;
  gap: 15rpx;
  justify-content: center;
}

.qr-action-btn {
  padding: 8rpx 20rpx;
  background: #4a90e2;
  color: #fff;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.qr-action-btn.save-btn {
  background: #52c41a;
}

.qr-code-error {
  padding: 40rpx 0;
  color: #999;
  font-size: 24rpx;
}

/* 实时在线 - 座位网格 */
.seat-scroll {
  max-height: 700rpx;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14rpx;
  padding: 10rpx 0;
}

.seat-card {
  background: #fff;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 16rpx 6rpx 12rpx;
  text-align: center;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
}

.seat-card.seat-online {
  border-color: #52C41A;
  background: #f6ffed;
}

.seat-card.seat-offline {
  border-color: #ff7875;
  background: #fff2f0;
}

.seat-card.seat-empty {
  border-color: #d9d9d9;
  background: #fafafa;
}

.seat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.seat-bind-name {
  font-size: 22rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.seat-online-tag {
  font-size: 20rpx;
}

.tag-online {
  color: #52C41A;
}

.tag-offline {
  color: #ff4d4f;
}

/* 图例 */
.seat-legend {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #666;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.dot-online {
  background: #52C41A;
}

.dot-offline {
  background: #ff7875;
}

.dot-empty {
  background: #d9d9d9;
}
